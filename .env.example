# SQLite lokal (dipakai otomatis jika TURSO_DATABASE_URL tidak diisi)
DATABASE_PATH=./data/saucybites.sqlite

# Turso Cloud SQLite (WAJIB untuk Vercel agar data permanen, opsional di lokal)
# Daftar gratis di https://turso.tech lalu buat database (turso db create saucybites)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password untuk Owner (Pemilik). Memiliki hak akses penuh (default dev: owner123).
OWNER_ACCESS_PASSWORD=owner123

# Password untuk Anggota Tim (Kasir / Operasional) (default dev: tim123).
TEAM_ACCESS_PASSWORD=tim123

# Rahasia session cookie (minimal 32 karakter).
SESSION_SECRET=saucybites-dev-secret-key-at-least-32-chars-long

# Konfigurasi Katalog Publik & Direct WhatsApp Checkout (/catalog)
STORE_NAME=SaucyBites
STORE_TAGLINE=Chicken bites saucy & minuman manis. Pilih menu, kirim pesanan lewat WhatsApp.
# Nomor WhatsApp admin/toko (bisa format 0812... atau 62812...)
STORE_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
