# SQLite lokal pada server Next.js. Jalur relatif dihitung dari root proyek.
DATABASE_PATH=./data/saucybites.sqlite

# Password untuk Owner (Pemilik). Memiliki hak akses penuh (default dev: owner123).
OWNER_ACCESS_PASSWORD=owner123

# Password untuk Anggota Tim (Kasir / Operasional) (default dev: tim123).
TEAM_ACCESS_PASSWORD=tim123

# Rahasia session cookie (minimal 32 karakter).
SESSION_SECRET=saucybites-dev-secret-key-at-least-32-chars-long
