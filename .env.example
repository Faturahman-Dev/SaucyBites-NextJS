# SQLite lokal pada server Next.js. Jalur relatif dihitung dari root proyek.
DATABASE_PATH=./data/saucybites.sqlite
# Opsional di development; wajib di production. Gunakan password baru milik tim.
TEAM_ACCESS_PASSWORD=
# Wajib jika password login diaktifkan. Buat random minimal 32 karakter.
SESSION_SECRET=
